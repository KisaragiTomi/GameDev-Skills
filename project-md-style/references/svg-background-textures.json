{
  "version": 1,
  "color_difference_rule": {
    "space": "sRGB",
    "measurement": "max_channel_difference_after_opacity_blend",
    "target_percent": 20,
    "target_rgb_levels": 51,
    "allowed_rgb_level_error": 1,
    "formula": "visible = base * (1 - opacity) + texture * opacity; max(abs(visible - base)) must be 51 ± 1"
  },
  "usage": {
    "svg_defs": "Copy matching entries into the SVG <defs> block and reference them from semantic classes such as .autoobject-dot or .sv-stripe.",
    "base_color": "Set the first child rect fill to the node base color.",
    "opacity": "Use the provided opacity when the texture color matches the entry. If either base or texture color changes, recompute opacity as 51 / max(abs(texture - base)).",
    "scope": "Use these only for subtle core-node background textures. Do not apply this rule to text, arrows, shadows, badges, icons, or non-pattern foreground marks."
  },
  "textures": {
    "autoobject-dot-cyan": {
